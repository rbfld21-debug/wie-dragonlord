+fn gm_fallback_program(program: u8) -> u8 {
+    // SMAF files can redefine the upper voice slots with Yamaha FM SysEx.
+    // General MIDI synths do not understand those definitions and interpret
+    // the same slots as sound effects (woodblock, taiko, reverse cymbal, ...),
+    // producing loud noise over an otherwise recognizable song. Keep the
+    // dedicated percussion channel intact, but render custom melodic voices
+    // with a neutral string-ensemble fallback.
+    if program >= 112 { 48 } else { program }
+}
