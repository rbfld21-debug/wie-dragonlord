index 00000000..b1255c55
--- /dev/null
+++ b/wie-web/src/ts/smaf-pcm.ts
@@ -0,0 +1,114 @@
+// SMAF's MA-5 setup messages contain instrument samples and their voice maps.
+// Ordinary MIDI sound banks ignore them, changing the timbre of the score.
+export function decodeYamahaAdpcm(bytes: Uint8Array): Float32Array {
+  const result = new Float32Array(bytes.length * 2);
+  const scale = [230, 230, 230, 230, 307, 409, 512, 614];
+  let predictor = 0;
+  let step = 127;
+  let position = 0;
+  for (const packed of bytes) {
+    for (const code of [packed & 15, packed >>> 4]) {
+      const difference = Math.trunc(step * (2 * (code & 7) + 1) / 8);
+      predictor = Math.max(-32768, Math.min(32767, predictor + (code & 8 ? -difference : difference)));
+      result[position++] = predictor / 32768;
+      step = Math.max(127, Math.min(24567, (step * scale[code & 7]) >> 8));
+    }
+  }
+  return result;
+}
+
+type PcmVoice = { wave: number; sampleRate: number; rootNote: number };
+type MidiChannel = { bankMsb: number; bankLsb: number; program: number };
+type ActiveVoice = { source: AudioBufferSourceNode; gain: GainNode };
+
+export class SmafPcmPlayer {
+  private readonly waves = new Map<number, Float32Array>();
+  private readonly voices = new Map<string, PcmVoice>();
+  private readonly channels: MidiChannel[] = Array.from({ length: 16 }, () => ({ bankMsb: 0, bankLsb: 0, program: 0 }));
+  private readonly active = new Map<string, ActiveVoice>();
+  private readonly buffers = new Map<string, AudioBuffer>();
+  private readonly context: AudioContext;
+  private readonly output: AudioNode;
+
+  constructor(context: AudioContext, output: AudioNode) {
+    this.context = context;
+    this.output = output;
+  }
+
+  // Return true only when an MA-5 sampled voice replaced the MIDI note.
+  public receive(data: Uint8Array, time: number): boolean {
+    if (data[0] === 0xf0 && data.length > 9 && data[1] === 0x43 && data[2] === 0x79 && data[3] === 0x07 && data[4] === 0x7f) {
+      if (data[5] === 0x03 && data.length > 10 && data[data.length - 1] === 0xf7) {
+        this.waves.set(data[6] & 0x7f, decodeYamahaAdpcm(data.subarray(8, -1)));
+      } else if (data[5] === 0x01 && data.length >= 28 && data[10] !== 0) {
+        const sampleRate = (data[11] << 8) | data[12];
+        if (sampleRate >= 2000 && sampleRate <= 48000) {
+          this.voices.set(`${data[6]}:${data[7]}:${data[8]}:${data[9]}`, {
+            wave: data[26] & 0x7f, sampleRate, rootNote: data[9] || 60,
+          });
+        }
+      }
+      return true;
+    }
+
+    const kind = data[0] & 0xf0;
+    const channel = data[0] & 15;
+    const state = this.channels[channel];
+    if (kind === 0xb0 && data.length >= 3) {
+      if (data[1] === 0) state.bankMsb = data[2];
+      if (data[1] === 32) state.bankLsb = data[2];
+      return false;
+    }
+    if (kind === 0xc0 && data.length >= 2) {
+      state.program = data[1];
+      return false;
+    }
+    if ((kind !== 0x90 && kind !== 0x80) || data.length < 3) return false;
+
+    const note = data[1];
+    const voice = this.voices.get(`${state.bankMsb}:${state.bankLsb}:${state.program}:0`);
+    if (!voice) return false;
+    const samples = this.waves.get(voice.wave);
+    if (!samples) return false;
+    const key = `${channel}:${note}`;
+    this.release(key, time);
+    if (kind === 0x80 || data[2] === 0) return true;
+
+    const bufferKey = `${voice.wave}:${voice.sampleRate}`;
+    let buffer = this.buffers.get(bufferKey);
+    if (!buffer) {
+      buffer = this.context.createBuffer(1, samples.length, voice.sampleRate);
+      buffer.getChannelData(0).set(samples);
+      this.buffers.set(bufferKey, buffer);
+    }
+    const source = this.context.createBufferSource();
+    source.buffer = buffer;
+    source.playbackRate.value = 2 ** ((note - voice.rootNote) / 12);
+    const gain = this.context.createGain();
+    gain.gain.value = data[2] / 127;
+    source.connect(gain);
+    gain.connect(this.output);
+    this.active.set(key, { source, gain });
+    source.onended = () => {
+      if (this.active.get(key)?.source === source) this.active.delete(key);
+      source.disconnect();
+      gain.disconnect();
+    };
+    source.start(time);
+    return true;
+  }
+
+  public release(key: string, time: number): void {
+    const active = this.active.get(key);
+    if (!active) return;
+    this.active.delete(key);
+    const at = Math.max(time, this.context.currentTime);
+    active.gain.gain.setValueAtTime(active.gain.gain.value, at);
+    active.gain.gain.linearRampToValueAtTime(0, at + 0.015);
+    try { active.source.stop(at + 0.016); } catch { /* A one-shot sample has already ended. */ }
+  }
+
+  public stop(time: number): void {
+    for (const key of this.active.keys()) this.release(key, time);
+  }
+}
