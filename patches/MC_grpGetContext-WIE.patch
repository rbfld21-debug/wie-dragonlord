diff --git a/wie-core-arm/data/binary_patches.toml b/wie-core-arm/data/binary_patches.toml
index ddd2fae2..9f04ef20 100644
--- a/wie-core-arm/data/binary_patches.toml
+++ b/wie-core-arm/data/binary_patches.toml
@@ -50,6 +50,67 @@
 # patches/hooks is fatal (likely a stale entry against an updated binary);
 # generic (hash-less) entries warn and continue.
 
+[[entry]]
+name = "Dragonlord retired carrier updater (v4 archive)"
+hash = "5c0b57227d626ec9c75bc31c2e694b60"
+
+# The shipped resources are already complete. Clear the obsolete carrier
+# update-required flag inside the original initializer, after its framebuffer
+# and resource state have been constructed. Skipping the initializer itself
+# leaves the title on a permanent white frame.
+[[entry.patch]]
+pc = 0x10c8ea
+expect = "1a 78"
+bytes = "1f 70"
+
+[[entry.hook]]
+kind = "memcpy"
+pattern = "78 47 00 00 01 40 2d e9 03 00 52 e3"
+
+[[entry.hook]]
+kind = "memset"
+pattern = "78 47 00 00 01 40 2d e9 04 00 52 e3"
+
+[[entry.hook]]
+kind = "strcpy"
+pattern = "70 b5 0b 1c 03 43 03 22 13 40 04 1c"
+
+[[entry.hook]]
+kind = "strlen"
+pattern = "30 b5 03 23 03 40 04 1c 00 2b"
+
+# Dragonlord's renderer spends most of its guest instruction budget in these
+# RGB565 loops. Their ABI is stable for this hash-keyed binary, so execute the
+# bulk pixel operations in the host instead of interpreting every Thumb op.
+[[entry.hook]]
+kind = "rgb565_transparent_copy"
+pc = 0x1083cd
+
+[[entry.hook]]
+kind = "rgb565_transparent_copy_reverse"
+pc = 0x108411
+
+[[entry.hook]]
+kind = "rgb565_half_blend_row"
+pc = 0x10a6eb
+exit_pc = 0x10a70b
+
+[[entry.hook]]
+kind = "rgb565_palette_copy"
+pc = 0x108325
+
+[[entry.hook]]
+kind = "rgb565_palette_copy_transparent"
+pc = 0x108349
+
+[[entry.hook]]
+kind = "rgb565_palette_copy_reverse"
+pc = 0x108371
+
+[[entry.hook]]
+kind = "rgb565_palette_copy_reverse_transparent"
+pc = 0x108395
+
 [[entry]]
 name = "Generic compiler library / inline copy patterns"
 
